# Database
POSTGRES_USER=scamguard
POSTGRES_PASSWORD=scamguard_dev_password
POSTGRES_DB=scamguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://scamguard:scamguard_dev_password@localhost:5432/scamguard

# Backend API
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production-use-64-char-random-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram Collector (MTProto - keep private, never commit .env)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./sessions/scamguard_collector
COLLECTION_INTERVAL_MINUTES=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true

